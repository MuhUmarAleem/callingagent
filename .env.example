# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Supabase Postgres connection string
# Use the "Transaction pooler" URL from Supabase → Settings → Database → Connection string
# Example: postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Required: Shared secret Vapi sends in x-vapi-secret header for tool calls
# Set this in Vapi dashboard under your server URL headers
VAPI_SHARED_SECRET=change-me-to-a-random-secret

# Optional: If set, POST/PUT/DELETE on /patients require header x-api-key
API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
