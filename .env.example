# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Postgres connection string (Supabase, Render, or local)
# postgres:// and postgresql:// are accepted; the app converts them to postgresql+psycopg://
# Supabase: Settings → Database → Connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# Required: Shared secret for Vapi tool calls and webhooks
# Vapi can send this as Authorization: Bearer <secret> or as x-vapi-secret
VAPI_SHARED_SECRET=change-me-to-a-random-secret

# Optional: If set, POST/PUT/DELETE on /patients require header x-api-key
API_KEY=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
